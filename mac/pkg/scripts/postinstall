#!/bin/sh
# Restarts the app as the logged-in user, so the new version runs and checks the monitor.
pkill -x HDRSwitch
user=$(stat -f %Su /dev/console)
if [ "$user" != root ] && [ "$user" != loginwindow ]; then
    launchctl asuser "$(id -u "$user")" sudo -u "$user" open "/Applications/HDR Switch.app"
fi
exit 0
