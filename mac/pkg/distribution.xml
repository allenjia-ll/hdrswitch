<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>HDR Switch</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="LICENSE.txt"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64"/>
    <!-- For the current user only: paths below are under their home folder, and no password is needed -->
    <domains enable_localSystem="false" enable_currentUserHome="true" enable_anywhere="false"/>
    <volume-check>
        <allowed-os-versions><os-version min="12.0"/></allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="HDR Switch">
        <pkg-ref id="io.github.allenjia-ll.hdrswitch.app"/>
        <pkg-ref id="io.github.allenjia-ll.hdrswitch.cli"/>
    </choice>
    <pkg-ref id="io.github.allenjia-ll.hdrswitch.app" version="@VERSION@" auth="none">app.pkg</pkg-ref>
    <pkg-ref id="io.github.allenjia-ll.hdrswitch.cli" version="@VERSION@" auth="none">cli.pkg</pkg-ref>
</installer-gui-script>
